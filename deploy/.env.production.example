# Cole a URL "Direct connection" do Supabase ou a URL do "Session Pooler" (porta 5432).
# Não use o Transaction Pooler (porta 6543): o worker pg-boss precisa de sessão persistente.
DATABASE_URL="postgresql://postgres.PROJECT_REF:CHANGE_ME@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
SHADOW_DATABASE_URL="postgresql://postgres.PROJECT_REF:CHANGE_ME@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
GESTEC_AUTH_MODE="supabase"
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_CHANGE_ME"
SUPABASE_ADMIN_EMAILS="caio.silveira@tecnoplanta.com.br,tiagorodrigues@tecnoplanta.com.br"
GESTEC_ALLOW_DEV_AUTH="false"
GESTEC_AUTH_SHARED_SECRET="generate-a-long-random-secret"
ZEEV_INBOUND_TOKEN="generate-a-long-random-token"
ZEEV_CALLBACK_URL="https://helpdesk.example.com/api/v1/gestec-help-desk/integrations/zeev/test-callback"
ZEEV_CALLBACK_TOKEN="generate-a-long-random-token"
ZEEV_API_BASE_URL="https://tecnoplanta.zeev.it"
ZEEV_API_TOKEN=""
ZEEV_TASK_TRIAGE_CODE=""
ZEEV_TASK_CONTACT_CODE=""
ZEEV_TASK_SERVICE_CODE=""
ZEEV_TASK_APPROVE_CODE=""
ZEEV_TASK_DEVIATION_CODE=""
ZEEV_TRIAGE_RESULT=""
ZEEV_CONTACT_RESULT="Concluir"
ZEEV_SERVICE_RESULT="Concluir"
ZEEV_APPROVE_RESULT="Aprovar"
ZEEV_DEVIATION_RETRY_RESULT=""
ZEEV_DEVIATION_CLOSE_RESULT=""
NEXT_PUBLIC_HELP_DESK_JORNADA_ONLY="true"
ZEEV_SYNC_ENABLED="false"
GESTEC_APP_PORT="3000"
GESTEC_STORAGE_DIR="/var/lib/gestec-helpdesk/storage"
# Para VPS com 1 GB de RAM ou menos, crie swap de 2 GB e mantenha 1536.
GESTEC_BUILD_NODE_HEAP_MB="1536"
